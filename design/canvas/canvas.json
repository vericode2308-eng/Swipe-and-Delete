, "DawnWelcome.dc.html", "DawnAlbums.dc.html", "DawnSwipe.dc.html", "DawnReview.dc.html", "DawnPaywall.dc.html", "DawnDone.dc.html", "Architecture.dc.html"], "notes": {"screens": {"x": 0, "y": -300, "text": "Dusk (dark look) — one flow, left to right", "kind": "title1", "maxW": 3210}, "arch": {"x": 0, "y": 2280, "text": "Architecture", "kind": "title1", "maxW": 1600}, "palette": {"x": 1680, "y": 2560, "w": 420, "fill": "gray", "text": "Two looks that follow the iPhone's appearance. DUSK: slate #262E3B base, glass white 12% with white edges, mist #E6ECF5 primary pill, blush #F2B8A8 = delete, sage #A9DCCD = keep. DAWN: mist #EEF1F6 base, glass white 55% with a bright edge, slate #262E3B primary pill, delete #A4472F on white / blush fill with dark text #2A1A16, keep #286B59. Photo backdrops: Dusk slate scrim 55%, Dawn mist scrim 75%. Cormorant Garamond titles, Inter in mock-ups (SF Pro in the app). Every accent also carries an icon or word."}, "dawn": {"x": 0, "y": 850, "text": "Dawn (light look) — follows the iPhone's appearance setting", "kind": "title1", "maxW": 2740}}, "designSystems": []}